!Sample_characteristics_ch1 = gender: male
!Sample_characteristics_ch1 = post-mortem interval (pmi): 2
!Sample_characteristics_ch1 = rna integrity number (rin): 5.8
!Sample_characteristics_ch1 = age at death: 81
!Sample_characteristics_ch1 = proteomics study: yes
!Sample_characteristics_ch1 = proteomics sv1: -0.0530743027
!Sample_characteristics_ch1 = proteomics sv2: 0.14184193
!Sample_characteristics_ch1 = proteomics sv3: -0.014892608
!Sample_characteristics_ch1 = microarray study: P_18
!Sample_molecule_ch1 = polyA RNA
