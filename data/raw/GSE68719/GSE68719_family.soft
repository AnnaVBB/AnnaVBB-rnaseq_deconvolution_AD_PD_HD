!Sample_characteristics_ch1 = gender: male
!Sample_characteristics_ch1 = post-mortem interval (pmi): 2
!Sample_characteristics_ch1 = rna integrity number (rin): 8.5
!Sample_characteristics_ch1 = age at death: 80
!Sample_characteristics_ch1 = proteomics study: no
!Sample_characteristics_ch1 = microarray study: P_12
